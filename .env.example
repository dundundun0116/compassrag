# CompassRAG 环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）。
# compassrag/llm/ 客户端从这里读取 openai 兼容端点配置；换通道（NIM → opencode go）只改这几行。

# —— 主 LLM（openai 兼容端点）——
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxxxxxxx
# 具体模型 id 以 NIM 模型页 / opencode 控制台为准
LLM_MODEL=deepseek-v4.1-flash

# —— Embedding（NIM 托管；若走本地 BGE-M3 兜底则留空）——
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=nvapi-xxxxxxxx
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
